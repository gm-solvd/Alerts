-- Auth token storage
CREATE TABLE auth_tokens (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    access_token TEXT NOT NULL,
    refresh_token TEXT NOT NULL
);

getTokens:
SELECT * FROM auth_tokens WHERE id = 1;

upsertTokens:
INSERT OR REPLACE INTO auth_tokens (id, access_token, refresh_token)
VALUES (1, ?, ?);

deleteTokens:
DELETE FROM auth_tokens WHERE id = 1;

hasTokens:
SELECT COUNT(*) FROM auth_tokens WHERE id = 1;
